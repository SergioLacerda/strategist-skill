---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Strategist · Escolha sua jornada</title>
<meta name="description" content="Strategist — escolha sua jornada: modo pragmático (guia técnico direto) ou modo épico (a experiência narrativa completa)." />
<meta name="theme-color" content="#14100a" />
<meta property="og:type" content="website" />
<meta property="og:title" content="Strategist · Escolha sua jornada" />
<meta property="og:description" content="Strategist — escolha sua jornada: modo pragmático (guia técnico direto) ou modo épico (a experiência narrativa completa)." />
<meta property="og:url" content="https://sergiolacerda.github.io/strategist-skill/" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
:root{
  --bg:#14100a; --panel:#1d1710; --panel2:#231c12;
  --line:rgba(232,194,90,.14); --line2:rgba(232,194,90,.30);
  --amber:#e8c25a; --amber-hi:#f8df90; --amber-dim:#b8933f;
  --orange:#cf7a2c; --green:#74cf8e;
  --text:#d9c49a; --muted:#9b865d; --faint:#6c5c3e;
  --mono:"IBM Plex Mono",ui-monospace,monospace;
  --display:"Cinzel",Georgia,serif;
}
*{box-sizing:border-box;}
html,body{margin:0;min-height:100vh;}
body{
  background:radial-gradient(120% 80% at 50% 0%,#241a10 0%,#160f08 55%,#0c0805 100%);
  color:var(--text);font-family:var(--mono);line-height:1.6;-webkit-font-smoothing:antialiased;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:48px 24px;min-height:100vh;
}
.langsw{position:fixed;top:18px;right:18px;display:inline-flex;border:1px solid var(--line2);border-radius:6px;overflow:hidden;background:rgba(20,15,9,.7);backdrop-filter:blur(6px);}
.langsw button{appearance:none;border:0;background:transparent;color:var(--faint);font-family:var(--mono);font-size:12px;padding:7px 12px;cursor:pointer;}
.langsw button.active{background:rgba(232,194,90,.14);color:var(--amber-hi);}

.head{text-align:center;max-width:680px;margin:0 auto;}
.crest{font-size:34px;color:var(--amber);text-shadow:0 0 22px rgba(232,194,90,.5);}
.kicker{font-family:var(--display);font-size:34px;letter-spacing:.16em;text-transform:uppercase;color:var(--amber-hi);margin:6px 0 0;text-shadow:0 0 26px rgba(232,194,90,.3);}
.tagline{font-family:var(--display);font-size:13px;letter-spacing:.36em;text-transform:uppercase;color:var(--orange);margin:12px 0 0;}
.rule{color:var(--amber-dim);letter-spacing:.5em;font-size:13px;margin:26px 0 0;}
.choose{font-family:var(--display);font-size:15px;letter-spacing:.3em;text-transform:uppercase;color:var(--orange);margin:26px 0 4px;text-align:center;}
.sub{color:var(--muted);font-size:14px;text-align:center;max-width:520px;margin:0 auto;}

.cards{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:880px;margin:36px auto 0;width:100%;}
.card{
  position:relative;display:flex;flex-direction:column;
  border:1px solid var(--line2);border-radius:10px;
  background:linear-gradient(180deg,rgba(42,33,23,.5),rgba(20,15,9,.4));
  box-shadow:inset 0 0 40px rgba(0,0,0,.4);
  padding:30px 28px;text-decoration:none;color:inherit;
  transition:border-color .18s,transform .12s,box-shadow .18s,background .18s;
}
.card:hover{border-color:var(--amber);transform:translateY(-3px);box-shadow:inset 0 0 40px rgba(0,0,0,.4),0 12px 34px rgba(0,0,0,.5),0 0 24px rgba(232,194,90,.14);}
.card .tag{align-self:flex-start;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--orange);border:1px solid var(--line2);border-radius:999px;padding:4px 12px;margin-bottom:18px;}
.card .card-title{display:flex;align-items:center;gap:14px;margin-bottom:0;}
.card .glyph{font-size:30px;line-height:1;color:var(--amber);text-shadow:0 0 18px rgba(232,194,90,.4);flex:none;}
.card h2{font-family:var(--display);font-size:27px;color:var(--amber-hi);margin:0;letter-spacing:.03em;}
.card p{font-size:13.5px;color:var(--muted);margin:12px 0 0;line-height:1.6;flex:1;}
.card .go{margin-top:22px;font-size:13px;letter-spacing:.06em;color:var(--amber);font-weight:500;}

.card.pragmatic{border-color:var(--line2);}
.card.pragmatic .tag{color:var(--green);border-color:rgba(116,207,142,.4);background:rgba(116,207,142,.08);}
.card.pragmatic .glyph{color:var(--green);text-shadow:0 0 18px rgba(116,207,142,.4);}
.card.pragmatic h2{color:#cfe8d6;}
.card.pragmatic:hover{border-color:var(--green);box-shadow:inset 0 0 40px rgba(0,0,0,.4),0 12px 34px rgba(0,0,0,.5),0 0 24px rgba(116,207,142,.16);}
.card.pragmatic .go{color:var(--green);}

.card.epic{
  background:
    radial-gradient(120% 80% at 70% 0%,rgba(207,122,44,.14),transparent 60%),
    linear-gradient(180deg,rgba(42,33,23,.55),rgba(20,15,9,.4));
}

.trust{margin-top:32px;display:flex;flex-wrap:wrap;justify-content:center;gap:8px 20px;font-size:11.5px;color:var(--faint);letter-spacing:.06em;max-width:680px;margin-left:auto;margin-right:auto;}
.trust span{white-space:nowrap;}
.trust span::before{content:"·";margin-right:8px;color:var(--amber-dim);}
.trust span:first-child::before{display:none;}

.foot{margin-top:28px;text-align:center;font-size:12px;color:var(--faint);letter-spacing:.06em;}
.foot a{color:var(--amber-dim);text-decoration:none;}
.foot a:hover{color:var(--amber);}

@media(max-width:680px){
  .cards{grid-template-columns:1fr;}
  .kicker{font-size:27px;}
}
</style>
</head>
<body>

<div class="langsw"><button data-lang="pt">PT</button><button data-lang="en">EN</button></div>

<div class="head">
  <div class="crest">✦</div>
  <div class="kicker" data-i18n="kicker">Strategist</div>
  <div class="tagline" data-i18n="tagline">Da demanda vaga ao handoff aprovado.</div>
  <div class="rule">━━━━━━ ⟡ ━━━━━━</div>
</div>

<div class="choose" data-i18n="choose">Escolha como explorar o pipeline</div>
<p class="sub" data-i18n="sub">Dois caminhos para a mesma skill de documentação. Escolha como prefere conhecê-la.</p>

<div class="cards">
  <a class="card pragmatic" href={`${base}pragmatic/`}>
    <span class="tag" data-i18n="pragTag">Recomendado para a maioria</span>
    <div class="card-title">
      <div class="glyph">⌗</div>
      <h2 data-i18n="pragTitle">Modo Pragmático</h2>
    </div>
    <p data-i18n="pragDesc">Guia técnico do pipeline, artefatos, Approval Gate e handoff pronto para executor.</p>
    <div class="go" data-i18n="pragCta">Abrir guia técnico →</div>
  </a>
  <a class="card epic" href={`${base}epic/`}>
    <span class="tag" data-i18n="epicTag">Experiência completa</span>
    <div class="card-title">
      <div class="glyph">⚜</div>
      <h2 data-i18n="epicTitle">Modo Épico</h2>
    </div>
    <p data-i18n="epicDesc">Console narrativo do mesmo pipeline documentation-first via Ranger, Archivist e Sniper.</p>
    <div class="go" data-i18n="epicCta">Entrar na masmorra →</div>
  </a>
</div>

<div class="trust" data-i18n-trust="trust">
  <span data-i18n="trust1">Sem mutação de código</span>
  <span data-i18n="trust2">Approval Gate antes da materialização</span>
  <span data-i18n="trust3">Handoff agnóstico de executor</span>
  <span data-i18n="trust4">Artefatos auditáveis</span>
</div>
<div class="foot"><a href="https://github.com/SergioLacerda/strategist-skill" target="_blank" rel="noopener">strategist-skill</a> · <span data-i18n="foot">Documentação · Sergio Lacerda &amp; Raphael Vernil</span></div>

<script>
const P={"pt":{"_lang":"pt-BR","_title":"Strategist · Da demanda vaga ao handoff aprovado","_desc":"Strategist transforma demandas ambíguas em análise governada, artefatos documentais aprovados e handoffs prontos para executor sem alterar código-fonte.","kicker":"Strategist","tagline":"Da demanda vaga ao handoff aprovado.","choose":"Escolha como explorar o pipeline","sub":"Dois caminhos para a mesma skill de documentação. Escolha como prefere conhecê-la.","pragTag":"Recomendado para a maioria","pragTitle":"Modo Pragmático","pragDesc":"Guia técnico do pipeline, artefatos, Approval Gate e handoff pronto para executor.","pragCta":"Abrir guia técnico →","epicTag":"Experiência completa","epicTitle":"Modo Épico","epicDesc":"Console narrativo do mesmo pipeline documentation-first via Ranger, Archivist e Sniper.","epicCta":"Entrar na masmorra →","trust1":"Sem mutação de código","trust2":"Approval Gate antes da materialização","trust3":"Handoff agnóstico de executor","trust4":"Artefatos auditáveis","foot":"Documentação · Sergio Lacerda & Raphael Vernil"},"en":{"_lang":"en","_title":"Strategist · From vague demand to approved handoff","_desc":"Strategist turns ambiguous requests into governed analysis, approved documentation artifacts, and executor-ready handoffs without mutating source code.","kicker":"Strategist","tagline":"From vague demand to approved handoff.","choose":"Choose how to explore the pipeline","sub":"Two paths to the same documentation-first skill. Pick how you'd like to get to know it.","pragTag":"Recommended for most","pragTitle":"Pragmatic Mode","pragDesc":"Technical guide for the pipeline, artifacts, Approval Gate, and executor-ready handoff.","pragCta":"Open technical guide →","epicTag":"Full experience","epicTitle":"Epic Mode","epicDesc":"Narrative console for the same documentation-first pipeline through Ranger, Archivist, and Sniper.","epicCta":"Enter the dungeon →","trust1":"No code mutation","trust2":"Approval Gate before materialization","trust3":"Executor-agnostic handoff","trust4":"Auditable artifacts","foot":"Documentation · Sergio Lacerda & Raphael Vernil"}};
type LangKey = keyof typeof P;
function applyLang(lang: string): void {
  if(!P[lang as LangKey])lang='pt';
  const dict=P[lang as LangKey];
  document.documentElement.lang=dict._lang;
  document.title=dict._title;
  const meta=document.querySelector('meta[name="description"]');
  if(meta)meta.setAttribute('content',dict._desc);
  document.querySelectorAll('[data-i18n]').forEach(function(el){
    const k=el.getAttribute('data-i18n'); if(k!=null&&dict[k as keyof typeof dict]!=null)el.textContent=dict[k as keyof typeof dict] as string;
  });
  document.querySelectorAll('.langsw button').forEach(function(b){
    b.classList.toggle('active',b.getAttribute('data-lang')===lang);
  });
  try{localStorage.setItem('strategist_lang',lang);}catch(e){}
  const u=new URL(location.href);u.searchParams.set('lang',lang);history.replaceState(null,'',u);
}
function initLang(): void {
  let lang: string|null=null;
  try{lang=new URL(location.href).searchParams.get('lang');}catch(e){}
  if(!lang){try{lang=localStorage.getItem('strategist_lang');}catch(e){}}
  if(!lang){lang=(navigator.language||'').toLowerCase().indexOf('pt')===0?'pt':'en';}
  applyLang(P[lang as LangKey]?lang:'pt');
}
document.addEventListener('click',function(e){
  const b=(e.target as Element|null)?.closest('.langsw button');
  if(b){e.preventDefault();applyLang(b.getAttribute('data-lang') as string);}
});
initLang();
</script>
</body>
</html>
