<!-- Tab/tile click wiring (no-framework, minimal) -->
<script>
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-tab]');
    if (!el) return;
    const tab = el.dataset.tab;
    if (tab) window.dispatchEvent(new CustomEvent('strategist:tab', { detail: tab }));
  });
</script>
