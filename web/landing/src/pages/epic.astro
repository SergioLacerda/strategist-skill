---
import Logo from '../components/Logo.astro';
import RoleCard from '../components/RoleCard.astro';
import InstallBlock from '../components/InstallBlock.astro';
import TabSwitcher from '../components/TabSwitcher';
import LangToggle from '../components/LangToggle';
import CopyButtons from '../components/CopyButton';
import FeaturesPanel from '../components/FeaturesPanel';
import MissionPanel from '../components/MissionPanel';
import Footer from '../components/Footer.astro';
import { STRUCTURE_FEATURES, STRUCTURE_ROLES, STRUCTURE_TOOLS } from '../data/structure';
import { MISSION_ROUTES } from '../data/architecture';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const quickstart = 'https://github.com/SergioLacerda/strategist-skill/blob/main/QUICKSTART.md';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Strategist · Governed AI Mission Orchestrator</title>
  <meta name="description" content="Strategist is an AI orchestration skill that turns requests into governed missions: discovery, refinement, Approval Gate, documentation materialization, and executor-ready handoff." />
  <meta name="theme-color" content="#14100a" />
</head>
<body>
<div class="stage"><div class="app crt" id="app">
  <header class="topbar">
    <a href={base} aria-label="Strategist home" style="display:inline-flex; align-items:center; text-decoration:none;"><Logo size={34} /></a>
    <TabSwitcher client:load />
    <div class="rightcluster">
      <a class="gh" href="https://github.com/SergioLacerda/strategist-skill" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub"><svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-.2-1.78-.89-3.64-3.95-3.64-.87 0-1.59.31-2.15.82-.2-.08-1.02-.36-2.12.08 0 0-.21.67.82 2.2-.18.64-.27 1.32-.27 2 0 .68.09 1.36.27 2 1.04 1.53.82 2.2.82 2.2 1.1.44 1.92.16 2.12.08.56.51 1.27.82 2.15.82 3.07 0 3.75-1.87 3.95-3.65.25.29.73.54 1.48.54 1.07 0 1.93-.01 2.2-.01.21 0 .46.15.38.55A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a>
      <LangToggle client:load />
    </div>
    <div class="sdd-float" data-pt="Uma Experiência SDD" data-en="An SDD Experience">Uma Experiência SDD</div>
  </header>

  <main class="main">
    <section class="panel active" data-panel="overview" aria-label="Visão Geral">
      <div class="hero"><Logo variant="mark" size={72} /><div class="ornament">━━━━━━ ⟡ ━━━━━━</div><Logo variant="wordmark" size={62} />
        <div class="tagline" style="margin-top:14px;" data-pt="A experiência com suas demandas nunca será a mesma." data-en="Your experience with your demands will never be the same.">A experiência com suas demandas nunca será a mesma.</div>
        <p class="lede" data-pt="Transforme demandas ambíguas em <b>missões governadas</b> para agentes IA. O Strategist orquestra discovery, refinamento e Approval Gate, produzindo artefatos documentais aprovados e handoffs prontos para executor — sem alterar código-fonte." data-en="Turn ambiguous demands into <b>governed missions</b> for AI agents. Strategist orchestrates discovery, refinement, and Approval Gate, producing approved documentation artifacts and executor-ready handoffs — without mutating source code.">Transforme demandas ambíguas em <b>missões governadas</b> para agentes IA. O Strategist orquestra discovery, refinamento e Approval Gate, produzindo artefatos documentais aprovados e handoffs prontos para executor — sem alterar código-fonte.</p>
        <div class="badges"><span class="pill">◆ <span data-pt="Workflow de IA Governado" data-en="Governed AI Workflow">Workflow de IA Governado</span></span><span class="pill">◆ <span data-pt="Gate de Aprovação Humana" data-en="Human Approval Gate">Gate de Aprovação Humana</span></span><span class="pill">◆ <span data-pt="Pronto para Plugins" data-en="Plugin-ready">Pronto para Plugins</span></span><span class="pill">◆ <span data-pt="Documentação viva" data-en="Living documentation">Documentação viva</span></span></div>
        <div class="cta"><button class="btn-primary tab-link" data-tab="invoke"><span aria-hidden="true">❯</span> <span data-pt="Instalar Strategist" data-en="Install Strategist">Instalar Strategist</span></button></div>
      </div>
      <div class="tiles">
        <button class="tile tab-link" data-tab="features"><div class="tg">☉</div><div class="tl" data-pt="Customize os papéis" data-en="Customize the roles">Customize os papéis</div><div class="ts" data-pt="Defina o grupo que conduz cada missão." data-en="Define the party that leads each mission.">Defina o grupo que conduz cada missão.</div></button>
        <button class="tile tab-link" data-tab="features"><div class="tg">‡</div><div class="tl" data-pt="Especialize papéis com múltiplas skills" data-en="Specialize roles with multiple skills">Especialize papéis com múltiplas skills</div><div class="ts" data-pt="Rankeie classes e arme-as com sub-skills." data-en="Rank classes and arm them with sub-skills.">Rankeie classes e arme-as com sub-skills.</div></button>
        <button class="tile tab-link" data-tab="mission"><div class="tg">⛨</div><div class="tl" data-pt="Approval Gate dentro do fluxo" data-en="Approval Gate inside the flow">Approval Gate dentro do fluxo</div><div class="ts" data-pt="Nenhuma materialização sem aprovação humana." data-en="No materialization without human approval.">Nenhuma materialização sem aprovação humana.</div></button>
        <button class="tile tab-link" data-tab="mission"><div class="tg">❒</div><div class="tl" data-pt="Sem mutação de código-fonte" data-en="No source-code mutation">Sem mutação de código-fonte</div><div class="ts" data-pt="Artefatos documentais + handoff pronto para executor." data-en="Documentation artifacts + executor-ready handoff.">Artefatos documentais + handoff pronto para executor.</div></button>
      </div>
    </section>

    <section class="panel" data-panel="features" aria-label="Funcionalidades">
      <div class="panel-head"><div class="eyebrow" data-pt="julgamento contextual" data-en="contextual judgment">julgamento contextual</div><h1 class="ptitle" data-pt="Funcionalidades" data-en="Features">Funcionalidades</h1><p class="pdesc" data-pt="Feats expressam decisões contextuais e conectam papéis, armas, tools, mecanismos, stages e artefatos." data-en="Features express contextual decisions and connect roles, weapons, tools, mechanisms, stages and artifacts.">Feats expressam decisões contextuais e conectam papéis, armas, tools, mecanismos, stages e artefatos.</p></div>
      <!-- jewel-disclosure: documentos · source cards · evidence packs · proposta · aceita · verificada · joias/jewels -->
      <FeaturesPanel client:load />
    </section>

    <section class="panel" data-panel="structure" aria-label="Componentes">
      <div class="panel-head"><div class="eyebrow" data-pt="componentes" data-en="components">componentes</div><h1 class="ptitle" data-pt="Componentes" data-en="Components">Componentes</h1><p class="pdesc" data-pt="Papéis assumem responsabilidades, armas fornecem especialidades, feats expressam julgamento e tools executam operações." data-en="Roles own responsibilities, weapons provide specialties, features express judgment and tools perform operations.">Papéis assumem responsabilidades, armas fornecem especialidades, feats expressam julgamento e tools executam operações.</p></div>
      <div class="scout-disclosure"><RoleCard glyph="🧭" role="Scout" klassPt="Batedor de Rota · Intake Router" klassEn="Route Scout · Intake Router" badgePt="interno" badgeEn="internal"><span data-pt="Classifica o pedido e escolhe a rota antes de qualquer papel agir. Não investiga a fundo — quando precisa de evidência, aciona o Ranger." data-en="Classifies the request and picks the route before any role acts. Does not investigate deeply — when evidence is needed, it hands off to Ranger.">Classifica o pedido e escolhe a rota antes de qualquer papel agir. Não investiga a fundo — quando precisa de evidência, aciona o Ranger.</span></RoleCard></div>
      <div class="structure-grid"><div class="structure-column"><div class="subhead"><span class="h" data-pt="Feats" data-en="Features">Feats</span><span class="rule"></span><span class="meta" data-pt="julgamento" data-en="judgment">julgamento</span></div>{STRUCTURE_FEATURES.map((item) => <button class="structure-item tab-link" data-tab="features" data-feature={item.link}><span class="feature-glyph">{item.glyph}</span><span><b>{item.name}</b><small data-pt={item.description.pt} data-en={item.description.en}>{item.description.pt}</small></span></button>)}</div><div class="structure-orchestrator"><div class="subhead"><span class="h">Strategist</span></div><div class="orch-card"><Logo variant="mark" size={52} /><b>FULL · SHORT · ROSTER</b><small data-pt="governa missões, fluxos e fronteiras" data-en="governs missions, flows and boundaries">governa missões, fluxos e fronteiras</small></div><div class="structure-arrow">↓ <span data-pt="delega · consulta" data-en="delegates · consults">delega · consulta</span> ↓</div></div><div class="structure-column"><div class="subhead"><span class="h" data-pt="Roles" data-en="Roles">Roles</span><span class="rule"></span><span class="meta" data-pt="papéis · armas" data-en="roles · weapons">papéis · armas</span></div><div class="role-grid">{STRUCTURE_ROLES.map((role) => <div class={`structure-role${role.planned ? ' planned' : ''}`}><span class="feature-glyph">{role.glyph}</span><b>{role.name}</b>{role.weapon && <small>⚔ {role.weapon}</small>}{role.fixed && <em data-pt="fixo" data-en="fixed">fixo</em>}{role.planned && <em data-pt="planejado" data-en="planned">planejado</em>}</div>)}</div></div></div>
      <div class="subhead"><span class="h" data-pt="Tools" data-en="Tools">Tools</span><span class="rule"></span><span class="meta" data-pt="operações com contrato" data-en="contracted operations">operações com contrato</span></div><div class="tools-grid">{STRUCTURE_TOOLS.map((tool) => <div class="tool-chip"><b>{tool.name}</b>{tool.description && <small data-pt={tool.description.pt} data-en={tool.description.en}>{tool.description.pt}</small>}</div>)}</div><div class="structure-banner"><strong data-pt="Responsabilidade estável, especialidade substituível." data-en="Stable responsibility, replaceable specialty.">Responsabilidade estável, especialidade substituível.</strong><span data-pt="O papel continua o mesmo quando troca de arma — sem alterar o pipeline principal." data-en="A role stays the same when it swaps weapons — without changing the main pipeline.">O papel continua o mesmo quando troca de arma — sem alterar o pipeline principal.</span></div>
    </section>

    <section class="panel" data-panel="mission" aria-label="Missão">
      <div class="panel-head"><div class="eyebrow" data-pt="pipeline" data-en="pipeline">pipeline</div><h1 class="ptitle" data-pt="Missão governada" data-en="Governed mission">Missão governada</h1><p class="pdesc" data-pt="Discovery e refinamento rodam autonomamente; a execução só avança após o Approval Gate." data-en="Discovery and refinement run autonomously; execution proceeds only after the Approval Gate.">Discovery e refinamento rodam autonomamente; a execução só avança após o Approval Gate.</p></div>
      <div class="mission-rules"><span>⛨ <span data-pt="Aprovação humana antes de materializar" data-en="Human approval before materialization">Aprovação humana antes de materializar</span></span><span>⛨ <span data-pt="Sem mutação de código-fonte" data-en="No source-code mutation">Sem mutação de código-fonte</span></span><span>⛨ <span data-pt="Handoff satisfaz o contrato do destinatário" data-en="Handoff satisfies the recipient contract">Handoff satisfaz o contrato do destinatário</span></span></div>
      <!-- Sniper is the documentation executor and prepares the executor handoff. -->
      <MissionPanel client:load />
      <div class="subhead"><span class="h" data-pt="rotas" data-en="routes">rotas</span><span class="rule"></span></div><p class="pdesc" data-pt="FULL e SHORT começam na triagem do Scout. WIZARD leva da instalação ao primeiro uso; ROSTER importa e mapeia as armas." data-en="FULL and SHORT start at Scout triage. WIZARD takes you from installation to first use; ROSTER imports and maps weapons.">FULL e SHORT começam na triagem do Scout. WIZARD leva da instalação ao primeiro uso; ROSTER importa e mapeia as armas.</p>
       <div class="route-grid">{MISSION_ROUTES.map((route) => <div class="route-row"><div class="route-heading"><strong>{route.tag}</strong><small data-pt={route.label.pt} data-en={route.label.en}>{route.label.pt}</small></div><div class="route-cells">{route.cells.map((cell) => <div class={`route-cell${cell.optional ? ' optional' : ''}${cell.code ? ' code' : ''}`}>{cell.family && <em>{cell.family}</em>}<b data-pt={cell.name.pt} data-en={cell.name.en}>{cell.name.pt}</b>{cell.sub && <small data-pt={cell.sub.pt} data-en={cell.sub.en}>{cell.sub.pt}</small>}</div>)}</div></div>)}</div>
    </section>

    <section class="panel" data-panel="invoke" aria-label="Instalação">
      <div class="panel-head"><div class="eyebrow" data-pt="o feitiço de invocação" data-en="the invocation spell">o feitiço de invocação</div><h1 class="ptitle" data-pt="Instalação" data-en="Installation">Instalação</h1><p class="pdesc" data-pt="Conjure o grupo no repositório-alvo. Um comando e a aventura começa." data-en="Conjure the party into the target repository. One command and the adventure begins.">Conjure o grupo no repositório-alvo. Um comando e a aventura começa.</p></div>
      <div class="invoke-panel"><div class="subhead"><span class="h" data-pt="obter o binário" data-en="get the binary">obter o binário</span><span class="rule"></span><span class="meta" data-pt="passo 1" data-en="step 1">passo 1</span></div><InstallBlock commands={[{ labelPt: 'go install (recomendado)', labelEn: 'go install (recommended)', command: 'go install github.com/SergioLacerda/strategist-skill/cmd/strategist@latest' }, { labelPt: 'curl · Linux / macOS / WSL', labelEn: 'curl · Linux / macOS / WSL', command: 'https://raw.githubusercontent.com/SergioLacerda/strategist-skill/main/scripts/install.sh' }]} sourcePt="Windows: baixe o strategist-windows-amd64.zip nos Releases, extraia e adicione ao PATH." sourceEn="Windows: download strategist-windows-amd64.zip from Releases, extract it, and add it to PATH." /><p class="pdesc" style="margin-top:18px;" data-pt={`Para o caminho canônico de primeira missão, consulte o <a href="${quickstart}" target="_blank" rel="noopener noreferrer">QUICKSTART.md ↗</a>.`} data-en={`For the canonical first-mission path, use the <a href="${quickstart}" target="_blank" rel="noopener noreferrer">QUICKSTART.md ↗</a>.`}>Para o caminho canônico de primeira missão, consulte o <a href={quickstart} target="_blank" rel="noopener noreferrer">QUICKSTART.md ↗</a>.</p><div class="subhead"><span class="h" data-pt="configurar o skill" data-en="configure the skill">configurar o skill</span><span class="rule"></span><span class="meta" data-pt="passo 2" data-en="step 2">passo 2</span></div><p class="pdesc" data-pt="No repositório-alvo, invoque o wizard:" data-en="In the target repository, invoke the wizard:">No repositório-alvo, invoque o wizard:</p><InstallBlock labelPt="Strategist CLI" labelEn="Strategist CLI" command="strategist install --wizard" /></div>
    </section>

    <section class="panel" data-panel="allies" aria-label="Aliados">
      <div class="panel-head"><div class="eyebrow" data-pt="gratidão" data-en="gratitude">gratidão</div><h1 class="ptitle" data-pt="Aliados" data-en="Allies">Aliados</h1><p class="pdesc" data-pt="Pessoas e projetos que ajudaram a dar forma ao Strategist." data-en="People and projects that helped shape Strategist.">Pessoas e projetos que ajudaram a dar forma ao Strategist.</p></div>
      <div class="subhead"><span class="h" data-pt="Pessoas" data-en="People">Pessoas</span><span class="rule"></span></div><div class="cards"> <RoleCard glyph="RV" role="Raphael Vernil" klassPt="Analista de Negócios" klassEn="Business Analyst"><span data-pt="Ajudou a consolidar a ideia do projeto, a visão geral do mecanismo e a visão de documentação." data-en="Helped consolidate the project idea, the mechanism overview and the documentation vision.">Ajudou a consolidar a ideia do projeto, a visão geral do mecanismo e a visão de documentação.</span><span class="ally-links"><a href="https://www.linkedin.com/in/raphael-vernil-0590a5142/" target="_blank" rel="noopener noreferrer" data-pt="LinkedIn ↗" data-en="LinkedIn ↗">LinkedIn ↗</a><a href="https://github.com/" target="_blank" rel="noopener noreferrer" data-pt="GitHub (perfil a localizar) ↗" data-en="GitHub (profile to be added) ↗">GitHub (perfil a localizar) ↗</a></span></RoleCard><RoleCard glyph="AM" role="Anderson Melo" klassPt="Arquiteto de Software" klassEn="Software Architect"><span data-pt="Contribuiu com consultorias e com o amadurecimento do mecanismo treasure-chest, mantendo a documentação viva." data-en="Provided consulting and helped mature the treasure-chest mechanism, keeping the documentation alive.">Contribuiu com consultorias e com o amadurecimento do mecanismo treasure-chest, mantendo a documentação viva.</span><span class="ally-links"><a href="https://www.linkedin.com/in/anderson-melo-b3439b3a/" target="_blank" rel="noopener noreferrer" data-pt="LinkedIn ↗" data-en="LinkedIn ↗">LinkedIn ↗</a><a href="https://github.com/Melo-Anderson" target="_blank" rel="noopener noreferrer" data-pt="GitHub ↗" data-en="GitHub ↗">GitHub ↗</a></span></RoleCard></div>
      <div class="subhead"><span class="h" data-pt="Skills de terceiros" data-en="Third-party skills">Skills de terceiros</span><span class="rule"></span></div><p class="pdesc" data-pt="Skills-base reconhecidas como providers especializados; preservamos a atribuição upstream." data-en="Recognized base skills as specialized providers; upstream attribution is preserved.">Skills-base reconhecidas como providers especializados; preservamos a atribuição upstream.</p><div class="ally-grid"><a class="ally-card" href="https://claudemarketplaces.com/skills/obra/superpowers/brainstorming" target="_blank" rel="noopener noreferrer"><b>brainstorming</b><span>obra/superpowers</span><small>claudemarketplaces.com ↗</small></a><a class="ally-card" href="https://claudemarketplaces.com/skills/itechmeat/llm-code/openspec" target="_blank" rel="noopener noreferrer"><b>openspec</b><span>itechmeat/llm-code</span><small>claudemarketplaces.com ↗</small></a></div><p class="muted" data-pt="Preservamos o nome, projeto e URL pública de origem. Não reivindicamos autoria de prompts, artefatos ou implementação upstream." data-en="We preserve the upstream name, project and public URL. We do not claim ownership of upstream prompts, artifacts or implementation.">Preservamos o nome, projeto e URL pública de origem. Não reivindicamos autoria de prompts, artefatos ou implementação upstream.</p><div class="subhead"><span class="h" data-pt="Licença" data-en="License">Licença</span><span class="rule"></span></div><p class="pdesc" data-pt={`MIT. Código aberto — consulte a <a href="https://github.com/SergioLacerda/strategist-skill/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">LICENSE ↗</a>.`} data-en={`MIT. Open source — see the <a href="https://github.com/SergioLacerda/strategist-skill/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">LICENSE ↗</a>.`}>MIT. Código aberto — consulte a <a href="https://github.com/SergioLacerda/strategist-skill/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">LICENSE ↗</a>.</p>
    </section>

    <!-- Canonical Quickstart: https://github.com/SergioLacerda/strategist-skill/blob/main/QUICKSTART.md -->
    <Footer epicHref="#allies" />
  </main>
</div></div>
<script is:inline>
  document.addEventListener('click', (event) => { const target = event.target instanceof Element ? event.target.closest('[data-tab]') : null; if (target && !target.matches('nav button')) window.dispatchEvent(new CustomEvent('strategist:tab', { detail: target.getAttribute('data-tab') })); });
</script>
<CopyButtons client:load />
</body>
</html>
