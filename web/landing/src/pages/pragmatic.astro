"Epic version ↗","skip":"Skip to Quickstart","kicker":"Technical guide · pragmatic mode","title":"Strategist","tagline":"An autonomous discovery → specification → execution pipeline, with a mandatory human approval gate before any code is written.","ctaQuick":"Quickstart (5 min)","ctaGh":"Repository ↗","note":"Provider-agnostic skill. Examples use Claude, but the system works with any LLM/skill that respects each role's input/output contract.","s_what":"What it is","whatP":"Strategist is an orchestration skill. A coordinator role splits a task into phases, delegates each phase to a specialist, and blocks at the approval gate until a human confirms. Each phase writes versionable artifacts to <code>.analysis/</code>, so the process is auditable and resumable.","s_flow":"Pipeline","flowNote":"Each arrow is an artifact handoff. Nothing moves from refinement to execution without human approval.","f1":"Discovery","f1d":"gather requirements + context","f2":"Spec","f2d":"refine into an actionable spec","f3":"Approval Gate","f3d":"human confirmation — mandatory","f4":"Execution","f4d":"implement the approved spec","s_roles":"Roles","rolesNote":"Neutral names used in this guide. In parentheses, the equivalent themed alias — both work in the templates.","th_role":"Role","th_alias":"Alias","th_resp":"Responsibility","r1":"Orchestrator","r1a":"Strategist","r1d":"Coordinates the mission, selects knowledge by task_type, delegates, and guards the approval gate.","r2":"Discoverer","r2a":"Ranger","r2d":"Explores the terrain: gathers requirements, maps context, returns a discovery report.","r3":"Spec Writer","r3a":"Archivist","r3d":"Refines the report into an actionable spec; records each decision in .analysis/.","r4":"Executor","r4a":"Sniper","r4d":"After approval, implements the spec with minimal, surgical changes.","r5":"Installer","r5a":"Wizard","r5d":"Installs the party into the target repo and runs the configuration wizard.","s_quick":"Quickstart","quickNote":"Minimal flow, no lore. Five steps from zero to first mission.","q1":"Get the binary","q1d":"With Go installed (recommended):","q1alt":"No Go? Download a pre-built binary from <a href=\"https://github.com/SergioLacerda/strategist-skill/releases\">GitHub Releases</a> (Linux, macOS, Windows).","q2":"Configure the skill","q2d":"In your target repository, run the wizard. It creates <code>.strategist/</code> with the agent config.","q3":"Start discovery","q3d":"Describe the task. The Discoverer gathers requirements and writes the report to <code>.analysis/</code>.","q4":"Review the spec","q4d":"The Spec Writer delivers the specification. <b>This is the approval gate:</b> review and approve before any code.","q5":"Execute","q5d":"Once approved, the Executor implements exactly the approved spec.","s_gate":"Approval Gate","gateP":"Discovery and refinement run autonomously. Execution does not. No code change happens without explicit human confirmation — no exceptions. It is the one inviolable rule of the system.","s_aliases":"Template aliases","aliasesNote":"Templates accept both the neutral and the themed name. Use whichever you prefer — they are interchangeable.","s_provider":"LLM support","providerP":"Initial examples use Claude providers, but the system supports any LLM/skill that respects the contract. Each role defines an input/output contract; any model that meets it can fill the slot.","foot_modes":"‹ choose mode"}};
type LangKey = keyof typeof T;
function applyLang(lang: string): void {
  if(!T[lang as LangKey]) lang='pt';
  const dict=T[lang as LangKey];
  document.documentElement.lang=dict._lang;
  document.title=dict._title;
  const meta=document.querySelector('meta[name="description"]');
  if(meta) meta.setAttribute('content',dict._desc);
  document.querySelectorAll('[data-i18n]').forEach(function(el){
    const k=el.getAttribute('data-i18n'); if(k!=null&&dict[k as keyof typeof dict]!=null) el.textContent=dict[k as keyof typeof dict] as string;
  });
  document.querySelectorAll('[data-i18n-html]').forEach(function(el){
    const k=el.getAttribute('data-i18n-html'); if(k!=null&&dict[k as keyof typeof dict]!=null) (el as HTMLElement).innerHTML=dict[k as keyof typeof dict] as string;
  });
  document.querySelectorAll('.langsw button').forEach(function(b){
    b.classList.toggle('active', b.getAttribute('data-lang')===lang);
  });
  try{localStorage.setItem('strategist_lang',lang);}catch(e){}
  const u=new URL(location.href); u.searchParams.set('lang',lang); history.replaceState(null,'',u);
}
function initLang(): void {
  let lang: string|null=null;
  try{lang=new URL(location.href).searchParams.get('lang');}catch(e){}
  if(!lang){try{lang=localStorage.getItem('strategist_lang');}catch(e){}}
  if(!lang){lang=(navigator.language||'').toLowerCase().indexOf('pt')===0?'pt':'en';}
  applyLang(T[lang as LangKey]?lang:'pt');
}
document.addEventListener('click',function(e){
  const b=(e.target as Element|null)?.closest('.langsw button');
  if(b){applyLang(b.getAttribute('data-lang') as string);}
});
initLang();
</script>
