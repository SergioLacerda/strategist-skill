generated/
# docs/generated/ is tracked on purpose — it is the committed baseline the
# docs-generated-gate (make/governance.mk) diffs against. See
# docs/adr/0025-generated-documentation-anti-drift.md.
!docs/generated/
!docs/generated/**

.strategist
# Strategist compiled artifacts (generated by install.sh, do not commit)
.strategist/.compiled/
# Stray local build of the CLI binary at repo root (bin/strategist is the
# documented, intentional build output location per CONTRIBUTING.md)
/strategist
# Local CLI build output. Release binaries are published through GitHub Releases.
/bin/
# GoReleaser output (local `goreleaser build/release --clean` runs)
/dist/
# Local coverage output generated by Make targets.
/coverage/
/coverage.out
/coverage.html
/cover.out
/coverage_cmd.out
# Analysis folder is local files only!
.analysis/

# `strategist eval harvest` bulk output — raw, uncurated mission snapshots.
# Only fixtures actually referenced by a test/config get committed explicitly.
/tests/evals/regression/*
!/tests/evals/regression/20260804-eval-fake-provider/
.tmp-gocache-cli/
.tmp-go-cache
